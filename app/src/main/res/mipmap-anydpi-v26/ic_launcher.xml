<?xml version="1.0" encoding="utf-8"?>
<!--
  API 26+ reads this instead of the mipmap PNGs, so the launcher can mask and
  animate the logo itself. BackgroundBlue is the app's own background, which is
  also what the PNGs are flattened onto.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/BackgroundBlue" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
