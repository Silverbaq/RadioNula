<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Compose Multiplatform refuses to start without this - its own
	  PlistSanityCheck throws on launch. Without it iOS caps the display at
	  60Hz, which Compose drives its frame clock from.
	-->
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
</dict>
</plist>
